# Copy to .env before running. The defaults work with docker compose.

DATABASE_URL=postgresql+psycopg2://rubric:rubric@postgres:5432/rubric

# Raised from 5 to 20 on day 11 of the incident. See docs/INCIDENT.md.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=30

MODEL_ENDPOINT=http://stub-model:9000
MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
MODEL_READ_TIMEOUT=30

SQS_QUEUE_URL=http://localstack:4566/000000000000/rubric-scoring
SQS_DLQ_URL=http://localstack:4566/000000000000/rubric-scoring-dlq
AWS_ENDPOINT_URL=http://localstack:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Stub model behaviour. STUB_RPM is scaled down to match the scaled-down seed;
# production quota for this model is 200 requests/minute.
STUB_RPM=40
STUB_LATENCY_MIN=2.0
STUB_LATENCY_MAX=12.0
STUB_TIMEOUT_RATE=0.04
